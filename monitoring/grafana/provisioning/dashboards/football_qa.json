      "id": 2,
      "title": "Relevance Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRESQL}" },
      "targets": [
        {
          "rawSql": "SELECT relevance, COUNT(*) AS count FROM conversations WHERE relevance IS NOT NULL GROUP BY relevance",
          "format": "table",
          "refId": "A"
