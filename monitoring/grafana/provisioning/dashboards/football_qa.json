        {
          "rawSql": "SELECT SUM(CASE WHEN score > 0 THEN 1 ELSE 0 END) AS thumbs_up, SUM(CASE WHEN score < 0 THEN 1 ELSE 0 END) AS thumbs_down, COUNT(*) AS total FROM feedback",
