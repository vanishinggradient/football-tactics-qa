# LLM Provider: "groq" (free) or "openai"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Groq API key (free at console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# OpenAI API key (optional, only if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Search backend: "elasticsearch" (docker) or "minsearch" (cloud/lightweight)
# Auto-detected if not set: uses ES if reachable, otherwise minsearch
# SEARCH_BACKEND=minsearch

# Database backend: "postgres" (docker) or "sqlite" (cloud/lightweight)
# Auto-detected if not set: uses PG if reachable, otherwise SQLite
# DB_BACKEND=sqlite

# Elasticsearch (only needed when SEARCH_BACKEND=elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=football_qa
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Grafana
GRAFANA_ADMIN_PASSWORD=admin
